---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
---

<Layout title="Home" description="Premium Puppy Windbreakers">
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-white dark:bg-gray-900 py-20 md:py-32">
    <div class="absolute inset-0 -z-10 h-full w-full bg-white from-[#fff4f4] to-[#fff] bg-[linear-gradient(to_right,#f8f8f8_1px,transparent_1px),linear-gradient(to_bottom,#f8f8f8_1px,transparent_1px)] bg-[size:6rem_4rem] dark:bg-gray-900 dark:[background:radial-gradient(circle_at_left_top,_var(--tw-gradient-stops))] from-[#e0e7ff] via-[#d1daff] to-[#e0e7ff]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Left Content -->
        <div class="text-center lg:text-left">
          <span class="inline-block px-3 py-1 mb-6 text-xs font-semibold tracking-wider text-blue-600 uppercase bg-blue-100 rounded-full dark:bg-blue-900/30 dark:text-blue-300">
            🐾 New Collection
          </span>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white leading-tight mb-6">
            Weatherproof Fun,<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-orange-500">
              Anytime, Anywhere
            </span>
          </h1>
          
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto lg:mx-0">
            Premium puppy windbreakers that are waterproof, breathable, and lightweight. Keep your pup comfortable and safe during every outdoor adventure.
          </p>
          
          <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4">
            <a href="#products" class="inline-flex items-center justify-center px-8 py-3 text-base font-bold text-white transition-all duration-200 bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              Shop Now
            </a>
            <a href="#features" class="inline-flex items-center justify-center px-8 py-3 text-base font-bold text-gray-700 dark:text-gray-200 transition-all duration-200 bg-white border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
              View Features
            </a>
          </div>

          <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-sm text-gray-500 dark:text-gray-400">
            <span class="flex items-center gap-1">✅ 30-Day Returns</span>
            <span class="flex items-center gap-1">🚚 Free Shipping</span>
            <span class="flex items-center gap-1">⭐ 10k+ Happy Owners</span>
          </div>
        </div>

        <!-- Right Image -->
        <div class="relative mt-10 lg:mt-0">
          <div class="absolute inset-0 bg-gradient-to-tr from-blue-200/50 to-orange-200/50 dark:from-blue-900/30 dark:to-orange-900/30 rounded-3xl blur-2xl transform rotate-3"></div>
          <img 
            src="/images/puppy-hero.jpg" 
            alt="Happy puppy wearing a windbreaker" 
            class="relative w-full max-w-md mx-auto rounded-3xl shadow-2xl transform -rotate-2 hover:rotate-0 transition duration-500 object-cover aspect-square"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 bg-gray-50 dark:bg-gray-800/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Why Choose Our Windbreakers?
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Designed by dog lovers, for active dogs. Built to withstand the elements while keeping your pet happy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-6">
            <span class="text-2xl">💧</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">IPX5 Waterproof</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Heavy-duty water resistance keeps your pup dry inside and out, even in downpours.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center mb-6">
            <span class="text-2xl">🌬️</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Windproof & Warm</h3>
          <p class="text-gray-600 dark:text-gray-300">
            High-density windproof fabric with a soft fleece lining locks in warmth against cold winds.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition">
          <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mb-6">
            <span class="text-2xl">🏃</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Freedom of Motion</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Ergonomic cut allows unrestricted running and jumping. Includes reflective strips for night safety.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section id="products" class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Best Sellers
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Top-rated jackets loved by puppies and owners alike.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Product Card 1 -->
        <div class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition duration-300">
          <div class="aspect-[4/3] bg-gray-100 dark:bg-gray-700 relative overflow-hidden">
            <img 
              src="/images/product-1.jpg" 
              alt="Alpine Explorer Jacket" 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Alpine Explorer Jacket</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
              Waterproof shell with fleece lining. Perfect for mountain hikes.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-blue-600">$29.99</span>
              <button class="text-sm font-semibold text-gray-900 dark:text-white hover:text-blue-600 transition">
                Add to Cart →
              </button>
            </div>
          </div>
        </div>

        <!-- Product Card 2 -->
        <div class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition duration-300">
          <div class="aspect-[4/3] bg-gray-100 dark:bg-gray-700 relative overflow-hidden">
            <img 
              src="/images/product-2.jpg" 
              alt="Urban Raincoat" 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Urban Raincoat</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
              Lightweight and packable. High-visibility reflective strips for safety.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-blue-600">$24.99</span>
              <button class="text-sm font-semibold text-gray-900 dark:text-white hover:text-blue-600 transition">
                Add to Cart →
              </button>
            </div>
          </div>
        </div>

        <!-- Product Card 3 -->
        <div class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-xl transition duration-300">
          <div class="aspect-[4/3] bg-gray-100 dark:bg-gray-700 relative overflow-hidden">
            <img 
              src="/images/product-3.jpg" 
              alt="Winter Warm-Up Parka" 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Winter Warm-Up Parka</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
              Extra thick insulation for cold winter nights. Cozy and durable.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-bold text-blue-600">$34.99</span>
              <button class="text-sm font-semibold text-gray-900 dark:text-white hover:text-blue-600 transition">
                Add to Cart →
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
